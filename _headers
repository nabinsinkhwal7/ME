# Cloudflare Pages Headers Configuration for Sinkhwal Services
# Optimizes caching, security, and performance

# Cache static assets aggressively
/styles.css
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/script.js
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Cache images and fonts
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML files - shorter cache with revalidation
/*.html
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Root HTML
/
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://wa.me; frame-ancestors 'none';

# Security headers for all files
/*
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
